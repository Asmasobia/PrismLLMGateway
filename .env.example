# Copy to .env and fill in. .env is gitignored: it holds machine-specific paths
# and the admin token. Never commit it.

# --- embedding model (vendored artifact, never fetched at request time) ---
# Directory holding the pre-downloaded bge-small-en-v1.5 ONNX cache.
# See docs/DESIGN_NOTES.md. The gateway fails fast at startup if this is unset
# or the model is missing.
PRISM_MODEL_CACHE=/absolute/path/to/prism-models

# Belt and braces: refuse to reach the network for model weights even if the
# cache lookup misses.
HF_HUB_OFFLINE=1

# --- database ---
# Must use the asyncpg driver. A plain postgresql:// URL is rejected at startup:
# it appears to work until the first query, then fails inside the event loop with
# an error that does not name the real cause.
PRISM_DATABASE_URL=postgresql+asyncpg://prism:prism@localhost:5433/prism

# --- gateway ---
PRISM_HOST=0.0.0.0
PRISM_PORT=8080

# Admin-plane bearer token, separate from the tenant virtual keys.
# docs/API_CONTRACT.md:31 allows any simple documented mechanism.
PRISM_ADMIN_TOKEN=change-me

# --- upstream providers ---
# Runtime config comes from a file based on data/gateway_config.sample.json.
# Gitignored too: it holds provider API keys, which docs/DATA_MODEL.md:44 treats
# as gateway secrets.
#     cp data/gateway_config.sample.json gateway_config.json
PRISM_GATEWAY_CONFIG=gateway_config.json

# Two timeouts, not one. A connect timeout should be short — a provider that has
# not accepted the socket in five seconds is down, and waiting the full read
# timeout to find that out delays the failover by the whole budget. A read
# timeout has to be generous, because a large model answering a long prompt
# legitimately takes tens of seconds and cutting it off retries work already paid
# for.
PRISM_UPSTREAM_TIMEOUT_SECONDS=30
PRISM_UPSTREAM_CONNECT_TIMEOUT_SECONDS=5

# --- semantic cache ---
# Entry lifetime, deployment-wide. Left unset, entries never expire — which is
# what makes the paraphrase demo reproducible: an entry written during setup is
# still there when the camera is on. A deployment that cares about staleness sets
# a number of seconds here.
# PRISM_CACHE_TTL_SECONDS=3600

# --- seed and pricing data (defaults point at the provided pack) ---
PRISM_PRICING_FILE=data/model_pricing.json
PRISM_SEED_FILE=data/seed_keys.json

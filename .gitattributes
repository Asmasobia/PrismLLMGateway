# Normalise line endings so a clone on any platform behaves the same.
* text=auto

# Shell scripts MUST stay LF. This machine has core.autocrlf on, and a CRLF
# checkout makes bash fail with "bad interpreter: /usr/bin/env bash^M".
*.sh text eol=lf

# Same reasoning for anything a Linux container reads verbatim.
Dockerfile  text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf

# The provided data pack is read by the provided scripts; keep it byte-stable.
*.json  text eol=lf
*.jsonl text eol=lf
